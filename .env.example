# Copy to .env locally. On cPanel, .env is written by GitHub Actions deploy (or create manually).

DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/cpaneluser_dbname"
AUTH_SECRET="long-random-secret"
JWT_SECRET="same-as-auth-secret"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NODE_ENV="development"

ADMIN_SEED_EMAIL="admin@sardarstore.com"
ADMIN_SEED_PASSWORD="change-me-before-first-seed"
ADMIN_NOTIFY_EMAIL="admin@sardarstore.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Sardar Store <noreply@sardarstore.com>"
